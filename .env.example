VIVABEM_DEBUG=true
VIVABEM_DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
VIVABEM_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
VIVABEM_CSRF_TRUSTED_ORIGINS=
VIVABEM_DB_NAME=vivabem
VIVABEM_DB_USER=vivabem_app
VIVABEM_DB_PASSWORD=troque-por-uma-senha-local
VIVABEM_DB_HOST=localhost
VIVABEM_DB_PORT=5432
VIVABEM_DB_TEST_NAME=vivabem_test
# Alternativa usada por plataformas de hospedagem:
DATABASE_URL=
VIVABEM_MEDIA_ROOT=

# E-mail. O backend de console é suficiente no desenvolvimento local.
VIVABEM_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
VIVABEM_DEFAULT_FROM_EMAIL=VivaBem <nao-responda@vivabem.local>
VIVABEM_EMAIL_HOST=localhost
VIVABEM_EMAIL_PORT=587
VIVABEM_EMAIL_HOST_USER=
VIVABEM_EMAIL_HOST_PASSWORD=
VIVABEM_EMAIL_USE_TLS=true
VIVABEM_EMAIL_USE_SSL=false

# Segurança e publicação HTTPS
VIVABEM_LOGIN_MAX_ATTEMPTS=5
VIVABEM_LOGIN_LOCKOUT_SECONDS=600
VIVABEM_PASSWORD_RESET_TIMEOUT=3600
VIVABEM_SESSION_COOKIE_AGE=14400
VIVABEM_ACTIVITY_UPDATE_SECONDS=120
VIVABEM_ONLINE_WINDOW_SECONDS=300
VIVABEM_SLOW_REQUEST_MS=1500
VIVABEM_LOG_LEVEL=INFO
VIVABEM_SECURE_SSL_REDIRECT=false
VIVABEM_SECURE_HSTS_SECONDS=0
VIVABEM_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
VIVABEM_SECURE_HSTS_PRELOAD=false
VIVABEM_BEHIND_HTTPS_PROXY=false
